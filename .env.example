# Dodo Payments Configuration
PORT=3001
# Dodo Payments Environment: 'test_mode' or 'live_mode' (defaults to 'live_mode' if unset or invalid)
# Valid values:
# - 'test_mode': sandbox mode for development and testing
# - 'live_mode': production mode for real payments
DODO_ENV=live_mode

# Dodo Payments API Key (Live mode)
DODO_PAYMENTS_API_KEY=your_dodo_live_api_key_here

# Dodo Webhook Secret (Live mode)
DODO_WEBHOOK_SECRET=your_dodo_live_webhook_secret_here

# Dodo Product ID (Live mode)
DODO_PRODUCT_ID=your_dodo_live_product_id_here

# Postgres / Neon Database Connection URL
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require
