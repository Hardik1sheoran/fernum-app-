# Fernum Environment Configuration
# Copy this file to .env to configure custom settings

# Dodo Payments Checkout Link (create a digital product in your Dodo Payments dashboard)
# e.g., https://checkout.dodopayments.com/buy/pdt_your_product_id_here
VITE_DODO_PAYMENT_URL=https://checkout.dodopayments.com/buy/pdt_fernum_pro_lifetime

# Dodo Payments Public Licensing API Base
VITE_DODO_API_BASE=https://api.dodopayments.com

# Set to true to run Vite web development preview without launching Electron child process
WEB_ONLY=false
