{
  "name": "fernum",
  "version": "0.1.0",
  "type": "module",
  "description": "Fernum - Native-feeling Windows storage analyzer and disk cleaner",
  "author": "Fernum",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "clean:electron": "cmd /c \"taskkill /F /IM electron.exe /T 2>nul || exit 0\"",
    "start:clean": "npm run clean:electron && npm start",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "systeminformation": "^5.33.10",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^5.0.0"
  }
}
